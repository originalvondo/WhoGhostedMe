{
  "manifest_version": 3,
  "name": "WhoGhostedMe",
  "version": "1.0",
  "description": "Ever wondered who ghosted you on Instagram? This extension finds out people who don't follow you back",
  "permissions": ["scripting", "tabs", "activeTab", "storage", "cookies"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhoGhostedMe"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worker.js", "results.html", "results.js"],
      "matches": ["*://*.instagram.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.instagram.com https://*.cdninstagram.com https://*.fbcdn.net;"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
